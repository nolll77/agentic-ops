# ==============================================================================
# Agentic-Ops Control Plane — Universal Environment Configuration Template
# ==============================================================================
# This template documents all configurable parameters across the Control Plane:
# 1. Universal LLM Provider Hub (OpenRouter, Gemini, OpenAI, Anthropic, Azure, Mistral, HuggingFace, Ollama)
# 2. Tailscale Mesh Network & Persistence (TS_STATE_B64, TS_AUTHKEY)
# 3. Security, Slack HITL Cryptography & Approvals Storage
# 4. Redis In-Memory Isolation & Rate-Limiting
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. UNIVERSAL LLM PROVIDER HUB CONFIGURATION
# ------------------------------------------------------------------------------
# Active provider selector:
# Supported options: openrouter | gemini | openai | anthropic | azure | mistral | huggingface | ollama
LLM_PROVIDER=openrouter

# Target model identifier (LiteLLM format):
# Examples:
#   OpenRouter (0 EUR) : openrouter/deepseek/deepseek-r1:free
#   OpenRouter (0 EUR) : openrouter/deepseek/deepseek-chat:free
#   OpenRouter (0 EUR) : openrouter/meta-llama/llama-3.3-70b-instruct:free
#   OpenRouter (0 EUR) : openrouter/google/gemini-2.0-flash-exp:free
#   Google Gemini      : gemini/gemini-1.5-pro-latest
#   OpenAI             : gpt-4o-mini
#   Anthropic          : claude-3-5-haiku-20241022
#   Azure OpenAI       : azure/gpt-4o
#   Mistral AI         : mistral/mistral-large-2411
#   HuggingFace        : huggingface/mistralai/Mistral-7B-Instruct-v0.2
#   Ollama (Local/VPN) : ollama/llama3.2:3b
LLM_MODEL=openrouter/deepseek/deepseek-r1:free

# Comma-separated fallback models chain (tried sequentially if primary fails or rate-limits):
LLM_FALLBACK_MODELS=openrouter/deepseek/deepseek-chat:free,openrouter/meta-llama/llama-3.3-70b-instruct:free

# Execution hyperparameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_STRUCTURED_MODE=instructor
# LLM_SEED=42

# --- Cognitive Role Specialization (Optional — defaults to LLM_MODEL & LLM_FALLBACK_MODELS) ---
# If omitted, every agent role automatically inherits the global LLM_MODEL and LLM_FALLBACK_MODELS.
# Override per-role to match specific cognitive requirements:
# - Remediation Coordinator : Deliberate CoT reasoning & blast radius calculation
# LLM_MODEL_REMEDIATION=openrouter/deepseek/deepseek-r1:free
# LLM_FALLBACK_MODELS_REMEDIATION=openrouter/meta-llama/llama-3.3-70b-instruct:free
#
# - Infrastructure Specialist: 256k context window for large Loki/system log dumps
# LLM_MODEL_INFRA=openrouter/google/gemma-4-31b-it:free
# LLM_FALLBACK_MODELS_INFRA=openrouter/google/gemma-4-26b-a4b-it:free
#
# - Data Specialist          : Low-latency covariance, drift matrices & JSON parsing
# LLM_MODEL_DATA=openrouter/google/gemma-4-26b-a4b-it:free
#
# - Model Specialist         : 70B parameter rigor for MLflow F1-score & metric drift
# LLM_MODEL_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
#
# - Standalone Web Chat SRE  : Responsive conversational model without <think> tags
# LLM_MODEL_CHAT=openrouter/deepseek/deepseek-chat:free
#
# Per-role providers can also be isolated if needed:
# LLM_PROVIDER_INFRA=openrouter
# LLM_PROVIDER_MODEL=ollama

# --- Provider Credentials & Connection Endpoints ---
# OpenRouter (Get free key at https://openrouter.ai):
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini:
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI:
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic:
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI:
AZURE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_API_BASE=https://your-resource-name.openai.azure.com/
AZURE_API_VERSION=2024-02-01

# Mistral AI:
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace Inference API:
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ollama Endpoint Configuration:
# - Local Workstation           : http://localhost:11434
# - Tailscale Mesh (Your Mac/PC): http://100.x.y.z:11434
# - Cloudflare Named Tunnel     : https://ollama.yourdomain.com
# - Vast.ai / External Cloud VPS: http://public-ip:11434
OLLAMA_BASE_URL=http://localhost:11434


# ------------------------------------------------------------------------------
# 2. TAILSCALE USERSERVICE MESH & PERSISTENCE
# ------------------------------------------------------------------------------
# Ephemeral Node State Persistence (Base64 encoded /tmp/tailscaled.state):
# Generated via GET /api/tailscale/status on first login
TS_STATE_B64=

# Headless Auth Key (Only if you are admin of the Tailnet):
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SOCKS5 Proxy Host and Port (Default: 127.0.0.1:1055):
TS_SOCKS5_PROXY=127.0.0.1:1055


# ------------------------------------------------------------------------------
# 3. CONTROL PLANE SECURITY & HITL CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Environment mode (production enforces strict fail-closed HMAC and WORM policies)
AGENTIC_OPS_ENV=production

# Slack HITL Signing Secret (Used to verify X-Slack-Signature HMAC-SHA256):
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Approval Database Storage (SQLite WAL path):
APPROVAL_DB_PATH=state/approvals.db

# Evidence WORM Cryptographic KMS Secret (Used for HMAC-SHA512 tamper-proof signing):
EVIDENCE_STORE_HMAC_KEY=super_secret_kms_tamper_proof_signing_key_512


# ------------------------------------------------------------------------------
# 4. REDIS IN-MEMORY ISOLATION & RATE-LIMITING
# ------------------------------------------------------------------------------
# Local in-container daemon or managed Redis endpoint:
REDIS_URL=redis://127.0.0.1:6379/0
